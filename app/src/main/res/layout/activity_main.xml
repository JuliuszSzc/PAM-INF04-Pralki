
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ADD8E6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Urządzenia Domowe"
            android:textSize="26sp"
            android:layout_margin="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Autor: Juliusz Szczesniak"
            android:textSize="14sp"
            android:layout_margin="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/pralka"
                android:scaleType="fitCenter"
                android:contentDescription="Pralka" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pralka"
                    android:textSize="22sp" />

                <EditText
                    android:id="@+id/numerPrania"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Podaj nr prania 1..12"
                    android:inputType="number"
                    android:background="#87CEEB"
                    android:textColor="#000080"
                    android:hintTextColor="#000080" />

                <Button
                    android:id="@+id/zatwierdz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zatwierdź"
                    android:backgroundTint="#4169E1"
                    android:layout_margin="10dp" />

                <TextView
                    android:id="@+id/wynikPrania"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Numer prania: nie podano" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="20dp"
                android:src="@drawable/odkurzacz"
                android:scaleType="fitCenter"
                android:contentDescription="Odkurzacz" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Odkurzacz"
                    android:textSize="22sp" />

                <Button
                    android:id="@+id/wlacz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Włącz"
                    android:backgroundTint="#4169E1"
                    android:layout_margin="10dp" />

                <TextView
                    android:id="@+id/stanOdkurzacza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Odkurzacz wyłączony" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Status: naładowany" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
